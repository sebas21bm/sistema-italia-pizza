<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" styleClass="usuario-tipo-root"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sistemapizzeria.controladores.UsuarioTipoController">

   <stylesheets>
      <URL value="@../../../css/estilos.css" />
   </stylesheets>

   <children>
      <Label fx:id="lb_titulo" layoutX="34.0" layoutY="21.0"
             text="Tipo de usuario" styleClass="usuario-tipo-titulo" />

      <Label layoutX="36.0" layoutY="86.0"
             text="Selecciona uno:" styleClass="usuario-tipo-subtitulo" />

      <Button layoutX="45.0" layoutY="138.0" mnemonicParsing="false"
              onAction="#clicEmpleado" prefHeight="125.0" prefWidth="158.0"
              text="Empleado" styleClass="usuario-tipo-btn-principal" />

      <Button layoutX="290.0" layoutY="138.0" mnemonicParsing="false"
              onAction="#clicCliente" prefHeight="125.0" prefWidth="158.0"
              text="Cliente" styleClass="usuario-tipo-btn-principal" />

      <Button layoutX="186.0" layoutY="306.0" mnemonicParsing="false"
              onAction="#clicCancelar" prefHeight="58.0" prefWidth="129.0"
              text="Cancelar" styleClass="usuario-tipo-btn-cancelar" />
   </children>
</AnchorPane>