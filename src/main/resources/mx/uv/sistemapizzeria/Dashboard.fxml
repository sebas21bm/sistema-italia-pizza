<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1180.0" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapizzeria.controladores.DashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #e0e0e0 transparent;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="58.0" prefWidth="244.0" style="-fx-background-color: white;">
                    <children>
                        <Label text="ITALIA PIZZA" textFill="#333333">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="20.0" />
                    </padding>
                </HBox>
                <Separator orientation="VERTICAL" prefHeight="58.0" prefWidth="11.0" />
                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lbl_nombreUsuario" text="María López " textFill="#333333">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label fx:id="lbl_rolUsuario" text="Administrador" textFill="#6c757d">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="20.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0">
                    <children>
                        <VBox alignment="CENTER_RIGHT">
                            <children>
                                <Label fx:id="lbl_hora" text="10:21 PM" textFill="#495057">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lbl_fecha" text="9/5/2026" textFill="#6c757d" />
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets right="20.0" />
                    </padding>
                </HBox>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="250.0" style="-fx-background-color: white; -fx-border-color: transparent #e0e0e0 transparent transparent;" BorderPane.alignment="CENTER">
            <children>
                <VBox>
                    <children>
                        <Label text="Administración" textFill="#6c757d">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <padding>
                                <Insets bottom="5.0" left="20.0" top="15.0" />
                            </padding>
                        </Label>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#clicMenuUsuarios" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #333333;" text="Usuarios">
                            <padding>
                                <Insets left="40.0" />
                            </padding>
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#clicMenuCerrarSesion" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #333333;" text="Cerrar sesión">
                            <padding>
                                <Insets left="40.0" />
                            </padding>
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

                <VBox>
                    <children>
                        <Label text="Inventarios" textFill="#6c757d">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <padding>
                                <Insets bottom="5.0" left="20.0" top="15.0" />
                            </padding>
                        </Label>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#clicMenuProductos" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #333333;" text="Productos">
                            <padding>
                                <Insets left="40.0" />
                            </padding>
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#clicMenuInsumos" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #333333;" text="Insumos">
                            <padding>
                                <Insets left="40.0" />
                            </padding>
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#clicMenuValidacion" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #333333;" text="Validación de inventarios">
                            <padding>
                                <Insets left="40.0" />
                            </padding>
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

                <VBox>
                    <children>
                        <Label text="Pedidos" textFill="#6c757d">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <padding>
                                <Insets bottom="5.0" left="20.0" top="15.0" />
                            </padding>
                        </Label>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#clicMenuPedidos" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #333333;" text="Pedidos">
                            <padding>
                                <Insets left="40.0" />
                            </padding>
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

                <Separator prefWidth="200.0">
                    <VBox.margin>
                        <Insets bottom="10.0" top="20.0" />
                    </VBox.margin>
                </Separator>

                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#clicMenuAyuda" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-font-weight: bold;" text="Ayuda / Acerca de">
                    <padding>
                        <Insets left="20.0" />
                    </padding>
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="panelContenido" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </StackPane>
    </center>
</BorderPane>
