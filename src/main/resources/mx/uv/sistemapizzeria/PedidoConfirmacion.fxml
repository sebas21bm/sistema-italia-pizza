<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="620.0" prefWidth="600.0" styleClass="pedido-confirmacion-root"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sistemapizzeria.controladores.PedidoConfirmacionController">

   <stylesheets>
      <URL value="@../../../css/estilos.css" />
   </stylesheets>

   <children>
      <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <VBox alignment="CENTER" spacing="6.0">
               <padding>
                  <Insets bottom="28.0" left="40.0" right="40.0" top="40.0" />
               </padding>
               <children>
                  <Label text="Resumen de Pedido" styleClass="pedido-confirmacion-titulo" />
                  <Label fx:id="lbl_subtitulo" text="Revisa los datos antes de confirmar" styleClass="pedido-confirmacion-subtitulo" />
               </children>
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS" styleClass="pedido-confirmacion-scroll">
               <content>
                  <VBox spacing="0.0" styleClass="pedido-confirmacion-card">
                     <VBox.margin>
                        <Insets bottom="16.0" left="36.0" right="36.0" top="0.0" />
                     </VBox.margin>
                     <children>

                        <HBox spacing="0.0" styleClass="pedido-confirmacion-fila">
                           <padding>
                              <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                           </padding>
                           <children>
                              <Label prefWidth="170.0" text="Fecha y Hora:" styleClass="pedido-confirmacion-etiqueta" />
                              <Label fx:id="lbl_fechaHora" text="10/05/2026, 16:05 hrs" styleClass="pedido-confirmacion-valor" />
                           </children>
                        </HBox>

                        <HBox spacing="0.0" styleClass="pedido-confirmacion-fila">
                           <padding>
                              <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                           </padding>
                           <children>
                              <Label prefWidth="170.0" text="Atiende:" styleClass="pedido-confirmacion-etiqueta" />
                              <Label fx:id="lbl_atiende" text="Maria Lopez" styleClass="pedido-confirmacion-valor" />
                           </children>
                        </HBox>

                        <HBox spacing="0.0" styleClass="pedido-confirmacion-fila">
                           <padding>
                              <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                           </padding>
                           <children>
                              <Label prefWidth="170.0" text="Cliente:" styleClass="pedido-confirmacion-etiqueta" />
                              <Label fx:id="lbl_cliente" text="David de la Mora" styleClass="pedido-confirmacion-valor" />
                           </children>
                        </HBox>

                        <HBox spacing="0.0" styleClass="pedido-confirmacion-fila">
                           <padding>
                              <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                           </padding>
                           <children>
                              <Label prefWidth="170.0" text="Dirección:" styleClass="pedido-confirmacion-etiqueta" />
                              <Label fx:id="lbl_direccion" maxWidth="360.0" text="Libertad 13, Xalapa, 45607"
                                     wrapText="true" styleClass="pedido-confirmacion-valor" />
                           </children>
                        </HBox>

                        <HBox spacing="0.0" styleClass="pedido-confirmacion-fila">
                           <padding>
                              <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                           </padding>
                           <children>
                              <Label prefWidth="170.0" text="Teléfono:" styleClass="pedido-confirmacion-etiqueta" />
                              <Label fx:id="lbl_telefono" text="228 666 6240" styleClass="pedido-confirmacion-valor" />
                           </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" styleClass="pedido-confirmacion-total-fila">
                           <padding>
                              <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                           </padding>
                           <children>
                              <Label fx:id="lbl_total" maxWidth="524.0" text="Total a pagar: $330.00"
                                     wrapText="true" styleClass="pedido-confirmacion-total" />
                           </children>
                        </HBox>

                     </children>
                  </VBox>
               </content>
            </ScrollPane>

            <HBox alignment="CENTER" spacing="16.0" styleClass="pedido-confirmacion-footer">
               <padding>
                  <Insets bottom="28.0" top="20.0" />
               </padding>
               <children>
                  <Button mnemonicParsing="false" onAction="#clicAtras" prefHeight="46.0"
                          prefWidth="140.0" text="Atrás" styleClass="pedido-confirmacion-btn-secundario" />

                  <Button mnemonicParsing="false" onAction="#clicConfirmar" prefHeight="46.0"
                          prefWidth="140.0" text="Confirmar" styleClass="pedido-confirmacion-btn-primario" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>