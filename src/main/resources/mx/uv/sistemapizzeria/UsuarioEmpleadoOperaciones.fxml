            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sistemapizzeria.controladores.UsuarioEmpleadoOperacionesController">

    <stylesheets>
        <URL value="@../../../css/estilos.css" />
    </stylesheets>

    <children>
