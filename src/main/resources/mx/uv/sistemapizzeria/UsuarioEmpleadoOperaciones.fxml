                        <TextField fx:id="txt_telefono" layoutX="28.0" layoutY="424.0"
                                   prefHeight="48.0" prefWidth="397.0"
                                   styleClass="usuario-empleado-form-campo" />

                        <Label layoutX="28.0" layoutY="486.0"
                               text="Correo electrónico" styleClass="usuario-empleado-form-label" />

                        <TextField fx:id="txt_correoElectronico" layoutX="28.0" layoutY="510.0"
                                   prefHeight="48.0" prefWidth="397.0"
                                   styleClass="usuario-empleado-form-campo" />

                        <Separator layoutX="28.0" layoutY="572.0" prefHeight="3.0" prefWidth="397.0"
                                   styleClass="usuario-empleado-form-separador" />

                        <Label layoutX="28.0" layoutY="588.0"
                               text="Calle" styleClass="usuario-empleado-form-label" />

                        <TextField fx:id="txt_calle" layoutX="28.0" layoutY="612.0"
