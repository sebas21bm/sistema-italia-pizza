                        <PasswordField fx:id="psw_contrasena" layoutX="28.0" layoutY="988.0"
                                       prefHeight="48.0" prefWidth="377.0"
                                       styleClass="usuario-empleado-form-campo" />

                        <TextField fx:id="txt_contrasenaVisible" layoutX="28.0" layoutY="988.0"
                                   managed="false" prefHeight="48.0" prefWidth="377.0"
                                   visible="false"
                                   styleClass="usuario-empleado-form-campo" />

                        <CheckBox fx:id="chkBtn_mostrar" layoutX="412.0" layoutY="1002.0"
