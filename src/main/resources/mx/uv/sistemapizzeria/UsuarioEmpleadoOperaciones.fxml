                                  styleClass="usuario-empleado-form-check" />

                        <Button layoutX="28.0" layoutY="1100.0" mnemonicParsing="false"
                                onAction="#clicCancelar" prefHeight="47.0" prefWidth="189.0"
                                text="Cancelar"
                                styleClass="usuario-empleado-form-btn-secundario" />

                        <Button layoutX="236.0" layoutY="1100.0" mnemonicParsing="false"
                                onAction="#clicGuardar" prefHeight="47.0" prefWidth="189.0"
