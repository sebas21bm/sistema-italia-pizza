                        <TextField fx:id="txt_apellidoPaterno" layoutX="28.0" layoutY="323.0"
                                   prefHeight="48.0" prefWidth="189.0"
                                   styleClass="usuario-empleado-form-campo" />

                        <TextField fx:id="txt_apellidoMaterno" layoutX="227.0" layoutY="323.0"
                                   prefHeight="48.0" prefWidth="198.0"
                                   styleClass="usuario-empleado-form-campo" />

                        <Separator layoutX="28.0" layoutY="385.0" prefHeight="3.0" prefWidth="397.0"
                                   styleClass="usuario-empleado-form-separador" />

