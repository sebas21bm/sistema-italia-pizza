                                   styleClass="usuario-empleado-form-campo" />

                        <Label layoutX="28.0" layoutY="213.0"
                               text="Nombre(s)" styleClass="usuario-empleado-form-label" />

                        <TextField fx:id="txt_nombres" layoutX="28.0" layoutY="238.0"
                                   prefHeight="48.0" prefWidth="397.0"
                                   styleClass="usuario-empleado-form-campo" />

                        <Label layoutX="28.0" layoutY="300.0"
                               text="Apellido paterno" styleClass="usuario-empleado-form-label" />

                        <Label layoutX="227.0" layoutY="300.0"
