<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f3f5fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapizzeria.controladores.UsuariosGestionController">
   <children>

      <AnchorPane fx:id="pnl_contenido" layoutX="180.0" prefHeight="650.0" prefWidth="820.0" style="-fx-background-color: #f3f5fa;">
         <children>
            <Label layoutX="20.0" layoutY="18.0" text="Gestión de Usuarios" textFill="#202932">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>

            <HBox fx:id="hbox_busqueda" alignment="CENTER_LEFT" layoutX="20.0" layoutY="70.0" prefHeight="42.0" prefWidth="300.0" spacing="10.0" style="-fx-background-color: white;">
               <padding>
                  <Insets left="14.0" right="8.0" />
               </padding>
               <children>
                  <Label text="⌕" textFill="#68727d">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>

                  <TextField fx:id="txt_buscar" prefHeight="40.0" prefWidth="230.0" promptText="Buscar por nombre, teléfono, dirección" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 12px; -fx-prompt-text-fill: #69727c;" />
               </children>
            </HBox>

            <Button fx:id="btn_buscar" layoutX="330.0" layoutY="72.0" mnemonicParsing="false" onAction="#clicBuscar" prefHeight="42.0" prefWidth="100.0" style="-fx-background-color: #1265f5; -fx-background-radius: 0; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" text="Buscar" />

            <TableView fx:id="tbl_usuarios" fixedCellSize="38.0" layoutX="20.0" layoutY="130.0" prefHeight="410.0" prefWidth="760.0" style="-fx-background-color: white; -fx-border-color: #d5dae2; -fx-border-width: 1; -fx-table-cell-border-color: #d5dae2; -fx-selection-bar: #eef1f6; -fx-selection-bar-non-focused: #eef1f6;">
               <columns>
                  <TableColumn fx:id="col_nombre" prefWidth="120.0" text="Nombre" />
                  <TableColumn fx:id="col_telefono" prefWidth="110.0" text="Teléfono" />
                  <TableColumn fx:id="col_email" prefWidth="150.0" text="Email" />
                  <TableColumn fx:id="col_direccion" prefWidth="220.0" text="Dirección" />
                  <TableColumn fx:id="col_estatus" prefWidth="90.0" text="Estatus" />
                  <TableColumn fx:id="col_tipo" prefWidth="70.0" text="Tipo" />
               </columns>
            </TableView>

            <Button fx:id="btn_nuevoUsuario" layoutX="20.0" layoutY="565.0" mnemonicParsing="false" onAction="#clicNuevoUsuario" prefHeight="45.0" prefWidth="170.0" style="-fx-background-color: #1265f5; -fx-background-radius: 0; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="+ Nuevo usuario" />

            <Button fx:id="btn_editar" layoutX="210.0" layoutY="565.0" mnemonicParsing="false" onAction="#clicEditar" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #1265ff; -fx-border-width: 2; -fx-border-radius: 0; -fx-background-radius: 0; -fx-text-fill: #1265ff; -fx-font-size: 14px; -fx-font-weight: bold;" text="Editar" />

            <Button fx:id="btn_eliminar" layoutX="350.0" layoutY="565.0" mnemonicParsing="false" onAction="#clicEliminar" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #1265ff; -fx-border-width: 2; -fx-border-radius: 0; -fx-background-radius: 0; -fx-text-fill: #1265ff; -fx-font-size: 14px; -fx-font-weight: bold;" text="Eliminar" />

            <TitledPane fx:id="tp_filtroEstatus" animated="false" expanded="false" layoutX="515.0" layoutY="78.0" prefWidth="130.0" style="-fx-background-color: white; -fx-border-color: #d9dde5; -fx-border-width: 1; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #202932;" text="Filtro">
               <content>
                  <VBox alignment="CENTER" prefWidth="130.0" spacing="0.0" style="-fx-background-color: white;">
                     <children>
                        <VBox alignment="CENTER_LEFT" prefWidth="130.0">
                           <children>
                              <RadioButton fx:id="rb_nombre" selected="true" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Nombre" textFill="#202932">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="tg_estatus" />
                                 </toggleGroup>
                                 <VBox.margin>
                                    <Insets left="14.0" top="10.0" />
                                 </VBox.margin>
                              </RadioButton>

                              <AnchorPane prefHeight="1.0" prefWidth="130.0" style="-fx-background-color: #d9dde5;">
                                 <VBox.margin>
                                    <Insets top="10.0" />
                                 </VBox.margin>
                              </AnchorPane>

                              <RadioButton fx:id="rb_telefono" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Teléfono" textFill="#202932" toggleGroup="$tg_estatus">
                                 <VBox.margin>
                                    <Insets bottom="10.0" left="14.0" top="10.0" />
                                 </VBox.margin>
                              </RadioButton>

                              <AnchorPane prefHeight="1.0" prefWidth="130.0" style="-fx-background-color: #d9dde5;" />

                              <RadioButton fx:id="rb_direccion" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Dirección" textFill="#202932" toggleGroup="$tg_estatus">
                                 <VBox.margin>
                                    <Insets bottom="10.0" left="14.0" top="10.0" />
                                 </VBox.margin>
                              </RadioButton>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </TitledPane>

            <TitledPane fx:id="tp_filtroTipo" animated="false" expanded="false" layoutX="660.0" layoutY="78.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #d9dde5; -fx-border-width: 1; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #202932;" text="Tipo">
               <content>
                  <VBox prefHeight="105.0" prefWidth="120.0" spacing="0.0" style="-fx-background-color: white;">
                     <children>
                        <RadioButton fx:id="rb_tipoEmpleado" prefHeight="22.0" prefWidth="100.0" selected="true" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Empleado" textFill="#202932">
                           <toggleGroup>
                              <ToggleGroup fx:id="tg_tipo" />
                           </toggleGroup>
                           <VBox.margin>
                              <Insets left="14.0" top="10.0" />
                           </VBox.margin>
                        </RadioButton>

                        <AnchorPane prefHeight="1.0" prefWidth="120.0" style="-fx-background-color: #d9dde5;">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </AnchorPane>

                        <RadioButton fx:id="rb_tipoCliente" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Cliente" textFill="#202932" toggleGroup="$tg_tipo">
                           <VBox.margin>
                              <Insets bottom="10.0" left="14.0" top="10.0" />
                           </VBox.margin>
                        </RadioButton>
                     </children>
                  </VBox>
               </content>
            </TitledPane>
         </children>
      </AnchorPane>

      <AnchorPane fx:id="pnl_menuLateral" prefHeight="650.0" prefWidth="180.0" style="-fx-background-color: white;">
         <children>
            <ImageView fx:id="img_logo" fitHeight="50.0" fitWidth="60.0" layoutX="10.0" layoutY="8.0" preserveRatio="true">
               <image>
                  <Image url="@../../../imagenes/logo%20mini.png" />
               </image>
            </ImageView>

            <Label layoutX="62.0" layoutY="19.0" text="Italia Pizza" textFill="#69727c">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Label>

            <Label layoutX="111.0" layoutY="39.0" text="Restaurante" textFill="#69727c">
               <font>
                  <Font size="8.0" />
               </font>
            </Label>

            <Accordion fx:id="ac_menu" layoutX="10.0" layoutY="70.0" prefWidth="160.0" style="-fx-background-color: #f1f3f8; -fx-border-color: transparent;">
               <panes>
                  <TitledPane fx:id="tp_administracion" animated="false" expanded="true" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #202932;" text="Administración">
                     <content>
                        <VBox prefWidth="158.0" spacing="8.0" style="-fx-background-color: #f1f3f8;">
                           <padding>
                              <Insets bottom="8.0" left="12.0" right="8.0" top="8.0" />
                           </padding>
                           <children>
                              <Button fx:id="btn_menuUsuarios" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#clicUsuarios" prefWidth="135.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #1265f5; -fx-font-weight: bold;" text="Usuarios">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Button>
                           </children>
                        </VBox>
                     </content>
                  </TitledPane>

                  <TitledPane fx:id="tp_inventarios" animated="false" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #202932;" text="Inventarios">
                     <content>
                        <VBox prefWidth="158.0" spacing="10.0" style="-fx-background-color: #f1f3f8;">
                           <padding>
                              <Insets bottom="10.0" left="12.0" right="8.0" top="8.0" />
                           </padding>
                           <children>
                              <Button fx:id="btn_menuProductos" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#clicProductos" prefWidth="135.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #202932;" text="Productos">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Button>

                              <Button fx:id="btn_menuInsumos" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#clicProductosInventario" prefWidth="135.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #202932; -fx-font-weight: bold; " text="Productos de Inventario">
                                 <font>
                                    <Font size="11.0" />
                                 </font>
                              </Button>

                              <Button fx:id="btn_menuValidacionInventarios" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#clicValidacionInventarios" prefWidth="135.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #202932;" text="Validación inventario">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Button>
                           </children>
                        </VBox>
                     </content>
                  </TitledPane>

                  <TitledPane fx:id="tp_pedidos" animated="false" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #202932;" text="Pedidos">
                     <content>
                        <VBox prefWidth="158.0" spacing="8.0" style="-fx-background-color: #f1f3f8;">
                           <padding>
                              <Insets bottom="8.0" left="12.0" right="8.0" top="8.0" />
                           </padding>
                           <children>
                              <Button fx:id="btn_menuPedidos" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#clicPedidos" prefWidth="135.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #202932;" text="Pedidos">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Button>
                           </children>
                        </VBox>
                     </content>
                  </TitledPane>
               </panes>
            </Accordion>

            <Button fx:id="btn_cerrarSesion" alignment="CENTER_LEFT" layoutX="18.0" layoutY="575.0" mnemonicParsing="false" onAction="#clicCerrarSesion" prefHeight="22.0" prefWidth="130.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #301f1f;" text="Cerrar sesión">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <AnchorPane layoutX="10.0" layoutY="604.0" prefHeight="1.0" prefWidth="160.0" style="-fx-background-color: #e1e5eb;" />

            <Button fx:id="btn_ayudaAcercaDe" alignment="CENTER_LEFT" layoutX="18.0" layoutY="615.0" mnemonicParsing="false" onAction="#clicAyudaAcercaDe" prefHeight="22.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #202932;" text="Ayuda / Acerca de">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>

   </children>
</AnchorPane>
