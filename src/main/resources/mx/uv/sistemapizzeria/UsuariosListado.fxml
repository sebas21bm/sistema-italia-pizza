<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="950.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapizzeria.controladores.UsuariosListadoController">
    <effect>
        <DropShadow color="#0000001a" offsetY="3.0" radius="10.0" />
    </effect>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="Gestión de Usuarios" textFill="#212529">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <TextField fx:id="txt_buscar" prefHeight="35.0" prefWidth="350.0" promptText="Buscar por nombre, teléfono o email..." style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                <Label text="Filtrar por:" textFill="#495057">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </Label>
                <ComboBox fx:id="cb_filtroEstatus" prefHeight="35.0" prefWidth="150.0" promptText="Estatus" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                <ComboBox fx:id="cb_filtroTipo" prefHeight="35.0" prefWidth="150.0" promptText="Tipo" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
            </children>
        </HBox>

        <TableView fx:id="tbl_usuarios" style="-fx-border-color: #e0e0e0;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="col_nombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="col_telefono" prefWidth="120.0" text="Teléfono" />
                <TableColumn fx:id="col_email" prefWidth="180.0" text="Email" />
                <TableColumn fx:id="col_direccion" prefWidth="250.0" text="Dirección" />
                <TableColumn fx:id="col_estatus" prefWidth="100.0" text="Estatus" />
                <TableColumn fx:id="col_tipo" prefWidth="100.0" text="Tipo" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#clicEliminar" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #dc3545; -fx-text-fill: #dc3545; -fx-font-weight: bold; -fx-border-radius: 5;" text="Eliminar" />
                <Button mnemonicParsing="false" onAction="#clicEditar" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #0d6efd; -fx-text-fill: #0d6efd; -fx-font-weight: bold; -fx-border-radius: 5;" text="Editar" />
                <Button mnemonicParsing="false" onAction="#clicNuevoUsuario" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ Nuevo usuario">
                    <effect>
                        <DropShadow color="#00000033" offsetY="2.0" />
                    </effect>
                </Button>
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>