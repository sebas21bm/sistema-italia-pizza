      <Button layoutX="202.0" layoutY="548.0" mnemonicParsing="false" onAction="#clicCancelar" prefHeight="42.0" prefWidth="140.0" style="-fx-background-color: white; -fx-background-radius: 0; -fx-border-color: #1265ff; -fx-border-width: 2; -fx-border-radius: 0; -fx-text-fill: #1265ff; -fx-font-size: 15px; -fx-font-weight: bold;" text="Cancelar" />

