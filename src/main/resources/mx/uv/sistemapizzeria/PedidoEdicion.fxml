<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="620.0" prefWidth="860.0" styleClass="pedido-edicion-root"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sistemapizzeria.controladores.PedidoEdicionController">

   <stylesheets>
      <URL value="@../../../css/estilos.css" />
   </stylesheets>

   <children>

      <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="860.0"
            spacing="10.0" styleClass="pedido-edicion-header">
         <children>
            <VBox spacing="1.0">
               <children>
                  <Label text="Formulario" styleClass="pedido-edicion-caption" />
                  <Label fx:id="lbl_titulo" text="Editar pedido #—" styleClass="pedido-edicion-titulo" />
               </children>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btn_cancelar" mnemonicParsing="false" onAction="#clicCancelar"
                    prefHeight="34.0" prefWidth="90.0" text="Cancelar"
                    styleClass="pedido-edicion-btn-cancelar" />

            <Button mnemonicParsing="false" onAction="#clicGuardar"
                    prefHeight="34.0" prefWidth="110.0" text="Guardar cambios"
                    styleClass="pedido-edicion-btn-guardar" />
         </children>
      </HBox>

      <VBox layoutX="16.0" layoutY="72.0" prefHeight="536.0" prefWidth="828.0" spacing="12.0">
         <children>

            <VBox spacing="6.0" styleClass="pedido-edicion-card-cliente">
               <children>
                  <Label text="Cliente del pedido" styleClass="pedido-edicion-seccion-titulo" />

                  <TableView fx:id="tbl_cliente" fixedCellSize="32.0" prefHeight="285.0" prefWidth="794.0"
                             styleClass="pedido-edicion-tabla">
                     <columns>
                        <TableColumn fx:id="col_nombre" prefWidth="170.0" text="Nombre" />
                        <TableColumn fx:id="col_numeroTelefono" prefWidth="110.0" text="Teléfono" />
                        <TableColumn fx:id="col_calle" prefWidth="130.0" text="Calle" />
                        <TableColumn fx:id="col_numeroCalle" prefWidth="80.0" text="Número" />
                        <TableColumn fx:id="col_codigoPostal" prefWidth="80.0" text="C.P." />
                        <TableColumn fx:id="col_ciudad" prefWidth="206.0" text="Ciudad" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <VBox spacing="8.0" VBox.vgrow="ALWAYS" styleClass="pedido-edicion-card-productos">
               <children>

                  <Label text="Productos del pedido" styleClass="pedido-edicion-seccion-titulo" />

                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <TextField fx:id="txt_busquedaProducto" prefHeight="34.0"
                                   promptText="Buscar producto por nombre…"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="pedido-edicion-campo" />

                        <Button fx:id="btn_buscarProducto" mnemonicParsing="false"
                                onAction="#clicBuscarProducto" prefHeight="34.0" prefWidth="34.0"
                                styleClass="pedido-edicion-btn-buscar" />
                     </children>
                  </HBox>

                  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="pedido-edicion-scroll">
                     <content>
                        <FlowPane fx:id="flow_productos" hgap="12.0" prefWrapLength="796.0"
                                  vgap="12.0" styleClass="pedido-edicion-flow" />
                     </content>
                  </ScrollPane>

                  <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="pedido-edicion-total-barra">
                     <children>
                        <Label text="Total estimado:" styleClass="pedido-edicion-total-label" />
                        <Label fx:id="lbl_total" text="0.00" styleClass="pedido-edicion-total-valor" />
                     </children>
                  </HBox>

               </children>
            </VBox>

         </children>
      </VBox>

   </children>
</AnchorPane>
