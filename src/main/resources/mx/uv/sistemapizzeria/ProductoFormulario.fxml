<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="700.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapizzeria.controladores.ProductoFormularioController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>

        <VBox spacing="5.0">
            <children>
                <Label text="Formulario" textFill="#6c757d">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="lbl_tituloFormulario" text="Registrar Producto" textFill="#212529">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <GridPane hgap="20.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Código:" textFill="#495057">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_codigo" prefHeight="35.0" promptText="Ej. PR-114" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.columnIndex="1">
                    <children>
                        <Label text="Nombre:" textFill="#495057">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_nombre" prefHeight="35.0" promptText="Ej. Pizza Hawaiana" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.rowIndex="1">
                    <children>
                        <Label text="Descripción:" textFill="#495057">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_descripcion" prefHeight="35.0" promptText="Breve descripción del producto" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Label text="Precio:" textFill="#495057">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_precio" prefHeight="35.0" promptText="Ej. 115.00" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.rowIndex="2">
                    <children>
                        <Label text="Restricciones:" textFill="#495057">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_restricciones" prefHeight="35.0" promptText="Opcional" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <Label text="Límite por cliente / Cantidad:" textFill="#495057">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_cantidad" prefHeight="35.0" promptText="Ej. 20" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                    <children>
                        <Label text="Fotografía:" textFill="#495057">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="txt_rutaFoto" editable="false" prefHeight="35.0" promptText="Ruta de la imagen seleccionada..." style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#clicExaminarFoto" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #e9ecef; -fx-text-fill: #495057; -fx-border-color: #cccccc; -fx-border-radius: 5;" text="Examinar..." />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </GridPane>

        <Separator prefWidth="200.0" />

        <VBox spacing="15.0">
            <children>
                <Label text="Receta / Insumos requeridos" textFill="#212529">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <ComboBox fx:id="cb_insumo" prefHeight="35.0" prefWidth="280.0" promptText="Seleccionar Insumo..." style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                        <TextField fx:id="txt_cantidadInsumo" prefHeight="35.0" prefWidth="120.0" promptText="Cant. (Ej. 0.5)" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                        <Button mnemonicParsing="false" onAction="#clicAgregarInsumo" prefHeight="35.0" prefWidth="40.0" style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+" />
                    </children>
                </HBox>

                <TableView fx:id="tbl_receta" prefHeight="150.0" style="-fx-border-color: #e0e0e0;">
                    <columns>
                        <TableColumn fx:id="col_recetaInsumo" prefWidth="278.0" text="Insumo" />
                        <TableColumn fx:id="col_recetaCantidad" prefWidth="78.0" text="Cantidad" />
                        <TableColumn fx:id="col_recetaMedida" prefWidth="143.0" text="Medida" />
                        <TableColumn fx:id="col_recetaAccion" prefWidth="135.0" text="Acción" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#clicCancelar" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #0d6efd; -fx-border-radius: 5; -fx-text-fill: #0d6efd; -fx-font-weight: bold; -fx-font-size: 14px;" text="Cancelar" />
                <Button mnemonicParsing="false" onAction="#clicGuardar" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 14px;" text="Guardar" />
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
