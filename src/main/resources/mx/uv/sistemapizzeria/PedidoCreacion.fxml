<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="620.0" prefWidth="860.0" styleClass="pedido-creacion-root"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.sistemapizzeria.controladores.PedidoCreacionController">

   <stylesheets>
      <URL value="@../../../css/estilos.css" />
   </stylesheets>

   <children>

      <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="860.0"
            spacing="10.0" styleClass="pedido-creacion-header">
         <children>
            <VBox spacing="1.0">
               <children>
                  <Label text="Formulario" styleClass="pedido-creacion-caption" />
                  <Label text="Realizar pedido" styleClass="pedido-creacion-titulo" />
               </children>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btn_cancelar" mnemonicParsing="false" onAction="#clicCancelar"
                    prefHeight="34.0" prefWidth="90.0" text="Cancelar"
                    styleClass="pedido-creacion-btn-cancelar" />

            <Button mnemonicParsing="false" onAction="#clicGuardar"
                    prefHeight="34.0" prefWidth="126.0" text="Guardar pedido"
                    styleClass="pedido-creacion-btn-guardar" />
         </children>
      </HBox>

      <HBox layoutX="16.0" layoutY="72.0" prefHeight="536.0" prefWidth="828.0" spacing="16.0">
         <children>

            <VBox prefHeight="536.0" prefWidth="672.0" spacing="10.0" styleClass="pedido-creacion-card">
               <children>

                  <Label text="1. Seleccionar cliente" styleClass="pedido-creacion-seccion-titulo" />

                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <TextField fx:id="txt_busqueda" prefHeight="32.0"
                                   promptText="Buscar por nombre, teléfono o email…"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="pedido-creacion-campo" />

                        <Button mnemonicParsing="false" onAction="#clicBuscar"
                                prefHeight="32.0" prefWidth="32.0" text="🔍"
                                styleClass="pedido-creacion-btn-buscar" />
                     </children>
                  </HBox>

                  <TableView fx:id="tbl_clientes" prefHeight="220.0" VBox.vgrow="NEVER"
                             styleClass="pedido-creacion-tabla">
                     <columns>
                        <TableColumn fx:id="col_nombre" prefWidth="214.0" text="Nombre" />
                        <TableColumn fx:id="col_telefono" prefWidth="101.0" text="Teléfono" />
                        <TableColumn fx:id="col_email" prefWidth="173.0" text="Email" />
                     </columns>
                  </TableView>

                  <Label text="Dirección de entrega:" styleClass="pedido-creacion-label-secundario" />

                  <ComboBox fx:id="cmb_cliente" prefHeight="34.0" prefWidth="999.0"
                            promptText="Selecciona una dirección…"
                            styleClass="pedido-creacion-combo" />

                  <Region VBox.vgrow="ALWAYS" />

                  <Button mnemonicParsing="false" onAction="#clicNuevoCliente"
                          prefHeight="34.0" prefWidth="999.0"
                          text="+ Registrar nuevo cliente"
                          styleClass="pedido-creacion-btn-nuevo-cliente" />

               </children>
            </VBox>

            <VBox prefHeight="536.0" prefWidth="392.0" spacing="10.0"
                  HBox.hgrow="ALWAYS" styleClass="pedido-creacion-card">
               <children>

                  <Label text="2. Agregar productos" styleClass="pedido-creacion-seccion-titulo" />

                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <TextField fx:id="txt_busquedaProducto" prefHeight="32.0"
                                   promptText="Buscar producto por nombre…"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="pedido-creacion-campo" />

                        <Button mnemonicParsing="false" onAction="#clicBuscarProducto"
                                prefHeight="32.0" prefWidth="32.0" text="🔍"
                                styleClass="pedido-creacion-btn-buscar" />
                     </children>
                  </HBox>

                  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                              styleClass="pedido-creacion-scroll">
                     <content>
                        <FlowPane fx:id="flow_productos" hgap="12.0" prefWrapLength="440.0"
                                  vgap="12.0" styleClass="pedido-creacion-flow" />
                     </content>
                  </ScrollPane>

                  <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="pedido-creacion-total-barra">
                     <children>
                        <Label text="Total estimado:" styleClass="pedido-creacion-total-label" />
                        <Label fx:id="lbl_total" text="0.00" styleClass="pedido-creacion-total-valor" />
                     </children>
                  </HBox>

               </children>
            </VBox>

         </children>
      </HBox>

   </children>
</AnchorPane>
