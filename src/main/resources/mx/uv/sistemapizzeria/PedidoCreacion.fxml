<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="620.0" prefWidth="860.0" style="-fx-background-color: #f7f8fc;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.sistemapizzeria.controladores.PedidoCreacionController">

   <children>

      <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="860.0" spacing="10.0" style="-fx-background-color: white;                  -fx-border-color: #e2e6ed;                  -fx-border-width: 0 0 1 0;                  -fx-padding: 0 24 0 24;">
         <children>
            <VBox spacing="1.0">
               <children>
                  <Label text="Formulario" textFill="#8892a0">
                     <font><Font size="11.0" /></font>
                  </Label>
                  <Label text="Realizar pedido" textFill="#1a2535">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_cancelar" mnemonicParsing="false" onAction="#clicCancelar" prefHeight="34.0" prefWidth="90.0" style="-fx-background-color: white; -fx-border-color: #1265f5; -fx-border-width: 2; -fx-background-radius: 6; -fx-text-fill: #1265f5; -fx-font-size: 12px; -fx-font-weight: bold;" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#clicGuardar" prefHeight="34.0" prefWidth="126.0" style="-fx-background-color: #1265f5; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" text="Guardar pedido" />
         </children>
      </HBox>

      <HBox layoutX="16.0" layoutY="72.0" prefHeight="536.0" prefWidth="828.0" spacing="16.0">
         <children>

            <VBox prefHeight="536.0" prefWidth="672.0" spacing="10.0" style="-fx-background-color: white;                      -fx-border-color: #e2e6ed; -fx-border-width: 1;                      -fx-border-radius: 8; -fx-background-radius: 8;                      -fx-padding: 16;">
               <children>

                  <Label text="1. Seleccionar cliente" textFill="#1a2535">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Label>

                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <TextField fx:id="txt_busqueda" prefHeight="32.0" promptText="Buscar por nombre, teléfono o email…" style="-fx-background-color: #f3f4f9;                                   -fx-border-color: #d9dde5; -fx-border-width: 1;                                   -fx-border-radius: 6; -fx-background-radius: 6;                                   -fx-font-size: 12px; -fx-padding: 0 10 0 10;" HBox.hgrow="ALWAYS" />
                        <Button  mnemonicParsing="false" onAction="#clicBuscar" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #1265f5;                                -fx-background-radius: 6;                                -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" text="🔍" />
                     </children>
                  </HBox>

                  <TableView fx:id="tbl_clientes" prefHeight="220.0" style="-fx-background-color: white;                               -fx-border-color: #e2e6ed; -fx-border-width: 1;                               -fx-table-cell-border-color: #e2e6ed;                               -fx-selection-bar: #ddeaff;                               -fx-selection-bar-non-focused: #ddeaff;" VBox.vgrow="NEVER">
                     <columns>
                        <TableColumn fx:id="col_nombre" prefWidth="214.0" text="Nombre" />
                        <TableColumn fx:id="col_telefono" prefWidth="101.0" text="Teléfono" />
                        <TableColumn fx:id="col_email" prefWidth="173.0" text="Email" />
                     </columns>
                  </TableView>

                  <Label text="Dirección de entrega:" textFill="#6f7882">
                     <font><Font size="11.0" /></font>
                  </Label>
                  <ComboBox fx:id="cmb_cliente" prefHeight="34.0" prefWidth="999.0" promptText="Selecciona una dirección…" style="-fx-background-color: #f3f4f9;                              -fx-border-color: #d9dde5; -fx-border-width: 1;                              -fx-background-radius: 6; -fx-border-radius: 6;                              -fx-font-size: 11px;" />

                  <Region VBox.vgrow="ALWAYS" />

                  <Button mnemonicParsing="false" onAction="#clicNuevoCliente" prefHeight="34.0" prefWidth="999.0" style="-fx-background-color: #f0f4ff;                            -fx-border-color: #1265f5; -fx-border-width: 1.5;                            -fx-border-radius: 6; -fx-background-radius: 6;                            -fx-text-fill: #1265f5;                            -fx-font-size: 12px; -fx-font-weight: bold;" text="+ Registrar nuevo cliente" />

               </children>
            </VBox>

            <VBox prefHeight="536.0" prefWidth="392.0" spacing="10.0" style="-fx-background-color: white;                      -fx-border-color: #e2e6ed; -fx-border-width: 1;                      -fx-border-radius: 8; -fx-background-radius: 8;                      -fx-padding: 16;" HBox.hgrow="ALWAYS">
               <children>

                  <Label text="2. Agregar productos" textFill="#1a2535">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Label>

                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <TextField fx:id="txt_busquedaProducto" prefHeight="32.0" promptText="Buscar producto por nombre…" style="-fx-background-color: #f3f4f9;                               -fx-border-color: #d9dde5; -fx-border-width: 1;                               -fx-border-radius: 6; -fx-background-radius: 6;                               -fx-font-size: 12px; -fx-padding: 0 10 0 10;" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#clicBuscarProducto" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #1265f5;                                -fx-background-radius: 6;                                -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" text="🔍" />
                     </children>
                  </HBox>

                  <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;                                -fx-border-color: transparent;                                -fx-padding: 0;" VBox.vgrow="ALWAYS">
                     <content>
                        <FlowPane fx:id="flow_productos" hgap="12.0" prefWrapLength="440.0" style="-fx-background-color: transparent;                                  -fx-padding: 4 0 4 0;" vgap="12.0" />
                     </content>
                  </ScrollPane>

                  <HBox alignment="CENTER_RIGHT" spacing="8.0" style="-fx-border-color: #e2e6ed; -fx-border-width: 1 0 0 0;                          -fx-padding: 10 0 0 0;">
                     <children>
                        <Label text="Total estimado:" textFill="#6f7882">
                           <font><Font size="13.0" /></font>
                        </Label>
                        <Label fx:id="lbl_total" text="0.00" textFill="#1265f5">
                           <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                     </children>
                  </HBox>

               </children>
            </VBox>

         </children>
      </HBox>

   </children>
</AnchorPane>
