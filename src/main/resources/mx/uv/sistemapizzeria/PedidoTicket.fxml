<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane
        prefHeight="750.0" prefWidth="600.0"
        style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dee2e6; -fx-border-radius: 12;"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="uv.lis.sistemapizzeria.controladores.ResumenPedidoController">

    <effect>
        <DropShadow color="#00000040" offsetX="0" offsetY="8" radius="24.0" />
    </effect>

    <children>
        <VBox spacing="0.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>

                <!-- ENCABEZADO -->
                <VBox alignment="CENTER" spacing="6.0">
                    <padding>
                        <Insets top="36.0" bottom="24.0" left="40.0" right="40.0" />
                    </padding>
                    <children>
                        <Label text="Resumen de Pedido" textFill="#1a1a1a">
                            <font><Font name="System Bold" size="30.0" /></font>
                        </Label>
                        <Label fx:id="lblSubtitulo" text="Pedido #0045 - En proceso" textFill="#555555">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <!-- TARJETA DE INFORMACIÓN -->
                <VBox spacing="0.0"
                      style="-fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-color: white; -fx-background-radius: 8;">
                    <VBox.margin>
                        <Insets left="36.0" right="36.0" bottom="20.0" />
                    </VBox.margin>
                    <children>

                        <!-- Fecha y Hora -->
                        <HBox spacing="0.0" style="-fx-border-color: transparent transparent #dee2e6 transparent;">
                            <padding><Insets top="14.0" bottom="14.0" left="18.0" right="18.0" /></padding>
                            <children>
                                <Label text="Fecha y Hora:" textFill="#1a1a1a" prefWidth="160.0">
                                    <font><Font name="System Bold" size="13.5" /></font>
                                </Label>
                                <Label fx:id="lblFechaHora" text="10/05/2026, 16:05 hrs" textFill="#333333">
                                    <font><Font size="13.5" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Atiende -->
                        <HBox spacing="0.0" style="-fx-border-color: transparent transparent #dee2e6 transparent;">
                            <padding><Insets top="14.0" bottom="14.0" left="18.0" right="18.0" /></padding>
                            <children>
                                <Label text="Atiende:" textFill="#1a1a1a" prefWidth="160.0">
                                    <font><Font name="System Bold" size="13.5" /></font>
                                </Label>
                                <Label fx:id="lblAtiende" text="Maria Lopez" textFill="#333333">
                                    <font><Font size="13.5" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Cliente -->
                        <HBox spacing="0.0" style="-fx-border-color: transparent transparent #dee2e6 transparent;">
                            <padding><Insets top="14.0" bottom="14.0" left="18.0" right="18.0" /></padding>
                            <children>
                                <Label text="Cliente:" textFill="#1a1a1a" prefWidth="160.0">
                                    <font><Font name="System Bold" size="13.5" /></font>
                                </Label>
                                <Label fx:id="lblCliente" text="David de la Mora" textFill="#333333">
                                    <font><Font size="13.5" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Dirección -->
                        <HBox spacing="0.0" style="-fx-border-color: transparent transparent #dee2e6 transparent;">
                            <padding><Insets top="14.0" bottom="14.0" left="18.0" right="18.0" /></padding>
                            <children>
                                <Label text="Direcci&#243;n:" textFill="#1a1a1a" prefWidth="160.0">
                                    <font><Font name="System Bold" size="13.5" /></font>
                                </Label>
                                <Label fx:id="lblDireccion" text="Libertad 13, Xalapa, 45607" textFill="#333333">
                                    <font><Font size="13.5" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Teléfono -->
                        <HBox spacing="0.0">
                            <padding><Insets top="14.0" bottom="14.0" left="18.0" right="18.0" /></padding>
                            <children>
                                <Label text="Tel&#233;fono:" textFill="#1a1a1a" prefWidth="160.0">
                                    <font><Font name="System Bold" size="13.5" /></font>
                                </Label>
                                <Label fx:id="lblTelefono" text="228 666 6240" textFill="#333333">
                                    <font><Font size="13.5" /></font>
                                </Label>
                            </children>
                        </HBox>

                    </children>
                </VBox>

                <!-- TABLA DE PRODUCTOS -->
                <VBox spacing="0.0">
                    <VBox.margin>
                        <Insets left="36.0" right="36.0" bottom="0.0" />
                    </VBox.margin>
                    <children>

                        <!-- Encabezado de columnas -->
                        <HBox style="-fx-border-color: #dee2e6; -fx-background-color: white; -fx-background-radius: 6 6 0 0; -fx-border-radius: 6 6 0 0;">
                            <padding><Insets top="12.0" bottom="12.0" left="16.0" right="16.0" /></padding>
                            <children>
                                <Label text="Cantidad" textFill="#555555" prefWidth="100.0">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label text="Descripci&#243;n" textFill="#555555" prefWidth="160.0">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label text="P. Unitario" textFill="#555555" prefWidth="110.0">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Label text="Subtotal" textFill="#555555" prefWidth="100.0">
                                    <font><Font size="13.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <Separator />

                        <!--
                            filaProductos: VBox que el controlador usa para
                            insertar filas dinámicas con agregarFilaProducto().
                            Las dos filas de abajo son solo placeholder visuales;
                            el controlador las limpia en initialize() y agrega las reales.
                        -->
                        <VBox fx:id="filaProductos" spacing="0.0">
                            <children>

                                <!-- Fila placeholder 1 -->
                                <HBox style="-fx-border-color: transparent transparent #dee2e6 transparent;">
                                    <padding><Insets top="16.0" bottom="16.0" left="16.0" right="16.0" /></padding>
                                    <children>
                                        <Label text="2" textFill="#333333" prefWidth="100.0">
                                            <font><Font size="13.5" /></font>
                                        </Label>
                                        <Label text="Pizza Hawaiana" textFill="#333333" prefWidth="160.0" wrapText="true">
                                            <font><Font size="13.5" /></font>
                                        </Label>
                                        <Label text="115.00" textFill="#333333" prefWidth="110.0">
                                            <font><Font size="13.5" /></font>
                                        </Label>
                                        <Label text="230.00" textFill="#333333" prefWidth="100.0">
                                            <font><Font size="13.5" /></font>
                                        </Label>
                                    </children>
                                </HBox>

                                <!-- Fila placeholder 2 -->
                                <HBox style="-fx-border-color: transparent transparent #dee2e6 transparent;">
                                    <padding><Insets top="16.0" bottom="16.0" left="16.0" right="16.0" /></padding>
                                    <children>
                                        <Label text="5" textFill="#333333" prefWidth="100.0">
                                            <font><Font size="13.5" /></font>
                                        </Label>
                                        <Label text="Coca-cola" textFill="#333333" prefWidth="160.0" wrapText="true">
                                            <font><Font size="13.5" /></font>
                                        </Label>
                                        <Label text="20" textFill="#333333" prefWidth="110.0">
                                            <font><Font size="13.5" /></font>
                                        </Label>
                                        <Label text="100" textFill="#333333" prefWidth="100.0">
                                            <font><Font size="13.5" /></font>
                                        </Label>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                        <!-- Fila Total -->
                        <HBox alignment="CENTER_RIGHT"
                              style="-fx-border-color: #dee2e6; -fx-background-color: #f8f9fa; -fx-background-radius: 0 0 6 6; -fx-border-radius: 0 0 6 6;">
                            <padding><Insets top="14.0" bottom="14.0" left="16.0" right="16.0" /></padding>
                            <children>
                                <VBox alignment="CENTER_RIGHT" prefWidth="210.0">
                                    <children>
                                        <Label text="Total a pagar:" textFill="#1a1a1a">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Label>
                                        <Label fx:id="lblTotal" text="330.00" textFill="#1a1a1a">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                    </children>
                </VBox>

                <!-- Espaciador -->
                <Pane VBox.vgrow="ALWAYS" />

                <!-- BOTÓN ACEPTAR -->
                <HBox alignment="CENTER">
                    <padding>
                        <Insets top="28.0" bottom="36.0" />
                    </padding>
                    <children>
                        <Button fx:id="btnAceptar"
                                text="Aceptar"
                                mnemonicParsing="false"
                                onAction="#clicAceptar"
                                prefHeight="46.0" prefWidth="290.0"
                                style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
